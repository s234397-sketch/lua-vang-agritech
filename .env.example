PORT=3000
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=LuaVangDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Mac dinh su dung Windows Authentication theo tai khoan dang chay Node.js.
# Neu dung SQL Server Authentication, bo comment va dien tai khoan:
# DB_USER=your_sql_login
# DB_PASSWORD=your_sql_password
